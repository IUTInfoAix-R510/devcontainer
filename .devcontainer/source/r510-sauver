#!/usr/bin/env bash
# r510-sauver : sauvegarde le travail sur GitHub, sans le rendre (R5.Real.10).
set -euo pipefail

usage() {
    cat <<'EOF'
Usage : r510-sauver ["message du commit"]

Sauvegarde votre travail sur GitHub, sur la branche courante.
Ce n'est PAS un rendu : rien n'est noté (pour être noté : r510-rendre, depuis main).

La commande fait, dans l'ordre, ce que vous pourriez taper vous-même :
  1. git add -A                     prend toutes vos modifications
  2. git commit -m "<message>"      les enregistre (message par défaut : « sauvegarde »)
  3. git push                       les envoie sur GitHub
Sur une nouvelle branche, pas encore envoyée sur GitHub, le push est
« git push -u origin <branche> » : il crée la branche sur GitHub et la relie à la
vôtre. Les sauvegardes suivantes font un simple git push.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

die() { printf '✗ %s\n' "$*" >&2; exit 1; }
# Affiche la commande (avec des guillemets autour des arguments qui contiennent une espace), puis la lance.
run() {
    local a ligne="→"
    for a in "$@"; do
        case "$a" in *" "*) ligne="$ligne \"$a\"" ;; *) ligne="$ligne $a" ;; esac
    done
    printf '%s\n' "$ligne"
    "$@"
}

racine=$(git rev-parse --show-toplevel 2>/dev/null) || die "Lancez r510-sauver dans le dossier de votre TP ou du projet (un dépôt git)."
cd "$racine"

branche=$(git symbolic-ref --short -q HEAD || true)
[ -n "$branche" ] \
    || die "Vous n'êtes sur aucune branche (HEAD détachée) : revenez sur une branche (git switch main), puis relancez r510-sauver."

run git add -A
if git diff --cached --quiet; then
    echo "  (rien de nouveau à enregistrer depuis le dernier commit)"
else
    run git commit -m "${1:-sauvegarde}" || echo "  (commit non fait, voir le message ci-dessus)"
fi
echec_push="Le push a échoué : votre travail est enregistré dans le codespace, pas sur GitHub."
if git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
    run git push || die "$echec_push"
else
    # Branche sans branche amont (créée dans le codespace) : un git push nu échouerait
    # (« has no upstream branch »).
    run git push -u origin "$branche" || die "$echec_push"
fi

echo
if [ "$branche" = "main" ]; then
    echo "✅ Travail sauvegardé sur GitHub. Ce n'est pas un rendu : pour être noté, r510-rendre."
else
    echo "✅ Travail sauvegardé sur GitHub, branche $branche. Ce n'est pas un rendu : pour être noté, r510-rendre, depuis main."
fi
