#!/usr/bin/env bash
# r510-rendre : rend le TP en cours, ou le projet, pour qu'il soit noté (R5.Real.10).
# Fait, en les affichant, les commandes git du rendu par tag décrit dans le README.
#
# Deux règles de rendu, choisies d'après le dépôt (voir est_projet plus bas) :
#   - TP : trois rendus au plus ; la note du correcteur automatique arrive dans la
#     Release du tag, quelques minutes plus tard ;
#   - projet (dépôts r510-projet-…) : cinq rendus au plus ; la Release ne porte
#     qu'un accusé de réception, et le dernier des cinq premiers rendus poussés
#     avant la clôture est noté hors ligne, après la clôture.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage : r510-rendre [--oui] [--sans-check]

Rend votre travail. Pour un TP, Classroom 50 le note avec le correcteur automatique
et publie le résultat dans une Release de votre dépôt, 2 à 5 minutes plus tard.
Pour le projet, la Release ne porte qu'un accusé de réception (ce n'est pas une
note) : le projet est noté après la clôture.

La commande fait, dans l'ordre, ce que vous pourriez taper vous-même :
  1. r510-verifier                       score indicatif, si le TP en a un
  2. git add -A                          prend toutes vos modifications
     git commit -m "rendu"               les enregistre (s'il y en a)
  3. git push                            les envoie sur GitHub
  4. git tag submit/AAAAMMJJ-HHMMSS      marque ce rendu
     git push origin submit/…            l'envoie : c'est ce qui constitue le rendu

Pour un TP, une mise à jour envoyée par l'équipe enseignante est intégrée avant
le score et avant le push, sans toucher à vos réponses.

Chaque tag submit/… est un rendu : trois au plus par TP, cinq au plus pour le
projet. La commande vous dit lequel ce sera et demande confirmation avant de rendre.

  --oui         ne pas demander de confirmation
  --sans-check  ne pas lancer r510-verifier
EOF
}

oui=0
check=1
for a in "$@"; do
    case "$a" in
        --oui) oui=1 ;;
        --sans-check) check=0 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Option inconnue : $a" >&2; usage >&2; exit 2 ;;
    esac
done

die() { printf '✗ %s\n' "$*" >&2; exit 1; }
# Affiche la commande (avec des guillemets autour des arguments qui contiennent une espace), puis la lance.
run() {
    local a ligne="→"
    for a in "$@"; do
        case "$a" in *" "*) ligne="$ligne \"$a\"" ;; *) ligne="$ligne $a" ;; esac
    done
    printf '%s\n' "$ligne"
    "$@"
}

racine=$(git rev-parse --show-toplevel 2>/dev/null) || die "Lancez r510-rendre dans le dossier de votre TP ou du projet (un dépôt git)."
cd "$racine"

# Le dépôt est-il celui du projet ? D'abord son nom : Classroom 50 crée
# r510-projet-group-<n> (devoir d'équipe), ou r510-projet-<login>. Le nom vient de
# l'URL de origin, à défaut de GITHUB_REPOSITORY (défini dans un codespace). Ensuite,
# pour une copie renommée ou le dépôt modèle lui-même, un fichier qu'aucun TP n'a :
# le manifeste des issues du projet, ou quetes.yml.
est_projet() {
    local url nom
    url=$(git remote get-url origin 2>/dev/null || true)
    nom=${url%/}; nom=${nom%.git}; nom=${nom##*[/:]}
    [ -n "$nom" ] || nom=${GITHUB_REPOSITORY:-}; nom=${nom##*/}
    case "$nom" in r510-projet-*) return 0 ;; esac
    [ -e .github/classroom/issues-manifeste.json ] || [ -d .github/classroom/issues ] || [ -f quetes.yml ]
}
if est_projet; then
    projet=1; max=5
else
    projet=0; max=3
fi

branche=$(git rev-parse --abbrev-ref HEAD)
[ "$branche" = "main" ] || die "Vous êtes sur la branche « $branche » : le rendu se fait depuis main (git switch main)."

# Le score indicatif se calcule sur le TP à jour.
r510-integrer --souple

# 1. Score indicatif.
if [ "$check" -eq 1 ] && [ -f package.json ] && grep -q '"check"' package.json; then
    printf '→ r510-verifier\n'
    sortie=$(r510-verifier 2>&1) || true
    score=$(printf '%s\n' "$sortie" | grep -E '^Score' | head -1)
    if [ -n "$score" ]; then
        printf '  %s (indicatif)\n' "$score"
    else
        printf '%s\n' "$sortie" | tail -5
        printf '  Le correcteur automatique n'"'"'a pas pu donner de score : vérifiez avec r510-verifier.\n'
    fi
fi

# Rang du rendu : les tags submit/… déjà sur GitHub (ceux des coéquipiers compris),
# ou, si GitHub ne répond pas, ceux du dépôt local.
if distants=$(git ls-remote --tags origin 'refs/tags/submit/*' 2>/dev/null); then
    deja=$(printf '%s\n' "$distants" | grep -c '^[0-9a-f].*refs/tags/submit/.*[^}]$' || true)
else
    deja=$(git tag -l 'submit/*' | wc -l)
fi
numero=$((deja + 1))
if [ "$projet" -eq 1 ]; then
    if [ "$numero" -gt "$max" ]; then
        printf '⚠️  Votre équipe a déjà poussé %s rendus. Seuls les cinq premiers comptent :\n' "$deja"
        printf '    ce rendu n° %s ne serait pas pris en compte, et il serait signalé.\n' "$numero"
    else
        printf 'Ce sera le rendu n° %s sur 5 de votre équipe (cinq au plus pour le projet).\n' "$numero"
        if [ "$numero" -eq "$max" ]; then
            printf '⚠️  C'"'"'est le dernier rendu qui compte : un rendu suivant serait ignoré.\n'
        fi
    fi
    printf '   Le rendu noté sera le dernier des cinq premiers poussé avant la clôture.\n'
elif [ "$numero" -gt 3 ]; then
    printf '⚠️  Ce serait votre rendu n° %s, alors que la consigne est de trois rendus au plus par TP.\n' "$numero"
else
    printf 'Ce sera votre rendu n° %s (trois au plus par TP).\n' "$numero"
fi

# Confirmation : seulement par la personne au clavier.
if [ "$oui" -eq 0 ]; then
    [ -t 0 ] || die "Pas de terminal interactif : relancez r510-rendre vous-même dans le terminal."
    read -r -p "Rendre maintenant ? [o/N] " reponse
    case "$reponse" in
        o|O|oui|Oui|OUI|y|Y|yes) ;;
        *) echo "Rien n'a été rendu."; exit 0 ;;
    esac
fi

# 2. Enregistrer.
run git add -A
if git diff --cached --quiet; then
    echo "  (rien de nouveau à enregistrer depuis le dernier commit)"
else
    # Le hook pre-commit du TP peut restaurer des fichiers de configuration, voire arrêter
    # un commit qui ne contenait qu'eux : dans ce cas on rend le dernier commit.
    run git commit -m "rendu" || echo "  (commit non fait : on rend le dernier commit)"
fi

# 3. Envoyer.
r510-integrer || die "La mise à jour du TP n'a pas pu être intégrée : votre travail n'est pas rendu. Lisez le message ci-dessus."
if [ "$projet" -eq 1 ]; then
    run git push || die "Le push a échoué : votre travail n'est pas rendu. Lisez le message ci-dessus.
  Si GitHub refuse parce que main a avancé (une Pull Request fusionnée entre-temps) :
  git pull, vérifiez que le projet compile, puis relancez r510-rendre."
else
    run git push || die "Le push a échoué : votre travail n'est pas rendu. Lisez le message ci-dessus."
fi

# 4. Marquer et envoyer le rendu.
tag="submit/$(TZ=Europe/Paris date +%Y%m%d-%H%M%S)"
run git tag "$tag"
run git push origin "$tag" || die "Le tag $tag n'a pas pu être envoyé : votre travail n'est pas rendu."

depot=$(git remote get-url origin | sed -E 's#^(https://|git@)github\.com[:/]##; s#\.git$##')
echo
if [ "$projet" -eq 1 ]; then
    if [ "$numero" -gt "$max" ]; then
        echo "⚠️  Rendu n° $numero envoyé : $tag. Il dépasse les cinq rendus : il ne compte pas."
    else
        echo "✅ Rendu n° $numero sur 5 envoyé : $tag"
    fi
    echo "   Dans quelques minutes, la Release de ce rendu porte un accusé de réception"
    echo "   (compilation, chargement, /api/sante, outils MCP) : ce n'est pas une note."
    echo "   https://github.com/$depot/releases/tag/$tag"
    echo "   La note est calculée après la clôture, sur le dernier des cinq premiers rendus"
    echo "   poussé avant elle."
else
    echo "✅ Rendu n° $numero envoyé : $tag"
    echo "   La note apparaît dans 2 à 5 minutes dans la Release de ce rendu :"
    echo "   https://github.com/$depot/releases/tag/$tag"
fi
